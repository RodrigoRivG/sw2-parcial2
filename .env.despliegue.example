# Inventario de configuración del backend en la nube. SIN secretos reales.
# Copiar como .env.despliegue.aws, .env.despliegue.azure o .env.despliegue.gcp
# (ignorados por Git) y completar los valores vacíos correspondientes.
# No leer este archivo con `source`: es una plantilla dotenv, no un script.
#
# IMPORTANTE: el docker-compose.yml actual es para desarrollo y NO consume toda
# esta plantilla. Hay que configurar el despliegue para inyectar cada variable
# en los contenedores indicados. Un .env no se exporta automáticamente a ellos.
# Las variables compartidas se entregan solo a los servicios que las necesitan.
# Los ejemplos .example son direcciones ficticias; reemplazarlas.
#
# Cada nube ejecuta el backend propio; n8n existe SOLO en GCP.
# PostgreSQL, Atlas, DynamoDB, S3, Firestore, GCS y Amazon MQ viven en sus
# proveedores correspondientes. Los tres despliegues se conectan a esos recursos.
# Si comparten datos y colas, forman un sistema compartido: sus consumidores
# pueden repartirse mensajes. Para entornos independientes, separar recursos,
# vhosts y datos; una sola instancia de n8n no agrega automáticamente tres vhosts.

# --- Autenticación común: servicios, Gateway, GraphQL y token URL para n8n ---
# Obtener del dominio público y realm de Keycloak. El ISSUER debe coincidir
# exactamente con el campo iss de los tokens, incluyendo esquema y ruta.
KEYCLOAK_ISSUER=https://auth.example/realms/agro
KEYCLOAK_JWKS_URI=https://auth.example/realms/agro/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=https://auth.example/realms/agro/protocol/openid-connect/token

# IMPORTANTE: inyectar estos nombres por contenedor; NO hay un valor global.
# KEYCLOAK_AUDIENCE:
#   gestión=servicio-gestion; inventario=servicio-inventario;
#   operaciones=servicio-operaciones; IA=servicio-ia; GraphQL=graphql-server.
# KEYCLOAK_CLIENT_ID (solo operaciones, IA y GraphQL): mismo nombre que arriba.
# KEYCLOAK_CLIENT_SECRET: usar el secreto correspondiente de la sección Keycloak.
# Gateway no necesita client secret ni KEYCLOAK_AUDIENCE; n8n usa N8N_CLIENT_SECRET.

# --- URL del Gateway: operaciones, IA, GraphQL y n8n ---
# En cada despliegue usar su Gateway; en el único n8n elegir UNO para el
# recordatorio diario. Sin barra final. Puede ser una URL interna accesible.
API_GATEWAY_URL=https://api.example

# --- API Gateway: destinos accesibles desde su contenedor ---
# Obtener de las direcciones de despliegue o DNS interno, sin rutas /api/...
GESTION_URL=http://servicio-gestion:8080
INVENTARIO_URL=http://servicio-inventario:3000
OPERACIONES_URL=http://servicio-operaciones:8080
IA_URL=http://servicio-ia:8080
GRAPHQL_URL=http://graphql-server:4000
# Dominios del frontend que hacen solicitudes desde el navegador, por comas.
CORS_ORIGENES_PERMITIDOS=https://app.example
# Opcionales: valores por defecto del Gateway.
GATEWAY_TIEMPO_LIMITE=10s
GATEWAY_TIEMPO_LIMITE_SINCRONIZACION=120000
GATEWAY_JWKS_TIEMPO_CONEXION=2s
GATEWAY_JWKS_TIEMPO_RESPUESTA=5s
GATEWAY_JWKS_PLAZO_TOTAL=8s

# --- Puertos por contenedor (nombres reales, configurar por separado) ---
# SERVER_PORT=8080 para gestión y Gateway.
# PORT=3000 para inventario; PORT=4000 para GraphQL; PORT=8080 para IA.
# Operaciones: su imagen Apache escucha en 8080; no usa PORT para cambiarlo.
# NODE_ENV=production para inventario y GraphQL.

# --- Gestión: Azure Database for PostgreSQL ---
# Portal Azure: host, base, usuario y contraseña del servidor aprovisionado.
SPRING_DATASOURCE_URL=jdbc:postgresql://REEMPLAZAR.postgres.database.azure.com:5432/gestion_db?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Inventario: MongoDB Atlas ---
# Atlas > Connect > Drivers. Usuario de base de datos, NO usuario del portal.
# Codificar caracteres reservados de usuario/contraseña para una URI.
MONGODB_URI=
# Formato: mongodb+srv://USUARIO:CLAVE@HOST/inventario_db?retryWrites=true&w=majority

# --- RabbitMQ / Amazon MQ: todos los productores y consumidores, incluido n8n ---
# Consola Amazon MQ: endpoint AMQPS y usuario del broker. Host sin esquema.
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_SSL=true
# Inventario e IA leen URL completa (codificar usuario, clave y vhost).
RABBITMQ_URL=
# Formato: amqps://USUARIO:CLAVE@HOST:5671/%2F
# Gestión usa los siguientes nombres Spring; mantenerlos consistentes con arriba.
SPRING_RABBITMQ_HOST=
SPRING_RABBITMQ_PORT=5671
SPRING_RABBITMQ_USERNAME=
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_SSL_ENABLED=true

# --- Operaciones: DynamoDB y S3 en AWS ---
# Región de tablas y bucket. Credenciales IAM con permisos para esos recursos.
# Con rol IAM/identidad del entorno, OMITIR las dos variables de claves en el
# contenedor para permitir la cadena de credenciales del SDK.
# El código actual arma credenciales explícitas con key/secret: no configurar
# aquí claves temporales que requieran session token sin adaptar esa integración.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# En AWS real OMITIR los overrides vacíos al inyectar el entorno: usar endpoints
# regionales del SDK; no apuntar a DynamoDB Local ni a LocalStack.
DYNAMODB_ENDPOINT=
DYNAMODB_PREFIJO_TABLAS=
AWS_ENDPOINT=
AWS_ENDPOINT_PUBLICO=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET=
# AWS_BUCKET es el nombre que lee operaciones; S3_BUCKET es alias del Compose local.
# Misma configuración para API, programador y consumidor de operaciones.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://operaciones.example
# Generar con php artisan key:generate --show si se usa cifrado de Laravel.
APP_KEY=
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- IA: Firestore y Google Cloud Storage ---
# Consola GCP: ID del proyecto y nombre de bucket existente.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
# ADC: preferir identidad asignada al servicio en GCP. Desde otras nubes usar
# identidad federada o credencial de cuenta de servicio montada como archivo.
# Descomentar SOLO si hay archivo montado; es ruta DENTRO del contenedor.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-ia.json
# NO establecer FIRESTORE_EMULATOR_HOST ni STORAGE_EMULATOR_HOST en nube real.
# GOOGLE_CLOUD_PROJECT es el nombre real de IA; GCP_PROJECT_ID es alias local.

# Ollama desplegado en Compute Engine y accesible desde IA por red privada o
# canal protegido. El cliente actual no configura una API key para Ollama.
OLLAMA_BASE_URL=http://ollama-interno:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q3_K_M
# Opcionales de IA: valores por defecto del código.
NIVEL_LOG=INFO
GATEWAY_TIEMPO_LIMITE_SEGUNDOS=5
TRABAJOS_COLA=servicio-ia.trabajos
TRABAJOS_CONCURRENCIA=2
TRABAJOS_CONSUMIDOR_ACTIVO=true
TRABAJOS_RETENCION_DIAS=30
MODELOS_INTERVALO_REVISION_SEGUNDOS=60
VISION_TAMANIO_MAXIMO_IMAGEN_MB=10
VISION_TAMANIO_MAXIMO_VIDEO_MB=50
AGENTES_NUM_CTX=8192
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Coincide con la imagen de producción; el modelo se descarga al construirla.
WHISPER_CARPETA=/modelos/whisper
WHISPER_ACTIVO=true
REPORTES_RETENCION_DIAS=7
REPORTES_TAMANIO_MAXIMO_AUDIO_MB=10

# --- GraphQL: opcionales, valores por defecto del código ---
GRAPHQL_TIEMPO_LIMITE_LLAMADA_MS=4000
GRAPHQL_PLAZO_CONSULTA_MS=4500
GRAPHQL_MAXIMO_LLAMADAS=200

# --- Keycloak: administración, PostgreSQL y realm ---
# Arrancar en modo producción; TLS/proxy y red se definen en el despliegue.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://REEMPLAZAR.postgres.database.azure.com:5432/keycloak_db?sslmode=require
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_HOSTNAME=https://auth.example
# Generar secretos distintos para cada client confidencial del realm agro.
# Se inyectan con estos nombres en la importación del realm y como
# KEYCLOAK_CLIENT_SECRET en operaciones, IA y GraphQL, respectivamente.
OPERACIONES_CLIENT_SECRET=
IA_CLIENT_SECRET=
GRAPHQL_CLIENT_SECRET=
N8N_CLIENT_SECRET=
# El realm versionado incluye usuarios de demostración y requiere este valor
# al importarlos. Generar contraseña propia o adaptar el realm para omitirlos.
KEYCLOAK_CLAVE_USUARIOS_PRUEBA=
# El realm agro está fijado en el JSON; cambiar KEYCLOAK_REALM no lo renombra.
# Configurar en Keycloak los redirect URIs y web origins de los frontends
# desplegados; son configuración del realm, no variables consumidas por la app.

# --- n8n: UNA instancia en GCP ---
# También necesita RabbitMQ, KEYCLOAK_TOKEN_URL, API_GATEWAY_URL y su client secret.
# Generar una clave aleatoria y conservarla junto con el volumen de datos.
N8N_ENCRYPTION_KEY=
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=America/La_Paz
TZ=America/La_Paz
NODE_OPTIONS=--max-old-space-size=640
# Firebase > Configuración del proyecto: ID y cuenta de servicio para FCM.
# Montar JSON privado como archivo de solo lectura; NO poner su contenido aquí.
FIREBASE_PROYECTO_ID=
FIREBASE_CUENTA_SERVICIO=/opt/agro/secretos/firebase-cuenta-servicio.json
# Persistir /home/node/.n8n y montar scripts/flujos en /opt/agro como en Compose.
# El dominio HTTPS/proxy de la interfaz se configura al definir su hosting.

# No se incluyen LOCALSTACK_AUTH_TOKEN ni credenciales de emuladores.
# SMTP no aplica hasta implementar la fase 2 opcional de n8n.
# El acceso para desplegar (AWS/Azure/GCP, registro de imágenes, SSH o CI) se
# configura en la herramienta de despliegue; no se entrega a los microservicios.
