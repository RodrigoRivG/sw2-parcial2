# Copia este archivo como .env  (cp .env.example .env)
# Credenciales SOLO para desarrollo local. El .env nunca se sube a GitHub (RNF-03).

POSTGRES_USER=sw2
POSTGRES_PASSWORD=sw2pass

RABBITMQ_USER=sw2
RABBITMQ_PASSWORD=sw2pass

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=agro

# Secretos de las cuentas de servicio (clients confidenciales de Keycloak).
# Keycloak los toma al importar docker/keycloak/realms/realm-agro.json, y cada servicio
# usa el suyo para pedir tokens. Valores SOLO locales: en la nube se generan otros.
OPERACIONES_CLIENT_SECRET=dev-operaciones-secreto
IA_CLIENT_SECRET=dev-ia-secreto
GRAPHQL_CLIENT_SECRET=dev-graphql-secreto
N8N_CLIENT_SECRET=dev-n8n-secreto

# Contraseña de los usuarios de prueba del realm (admin.prueba, tecnico.prueba,
# gerencia.prueba, multirol.prueba). Solo desarrollo local.
KEYCLOAK_CLAVE_USUARIOS_PRUEBA=prueba123

# AWS local: DynamoDB Local y LocalStack aceptan cualquier credencial
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=evidencias

# Token de LocalStack (plan Hobby, gratuito para uso no comercial):
# crea una cuenta en https://app.localstack.cloud y copia el token aquí.
LOCALSTACK_AUTH_TOKEN=

# GCP local (emuladores de Firestore y Cloud Storage)
GCP_PROJECT_ID=sw2-local
GCS_BUCKET=ia-artefactos

# Modelo de Ollama (corre nativo en Windows)
OLLAMA_MODEL=qwen2.5:7b-instruct-q3_K_M
