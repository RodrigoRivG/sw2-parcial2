# Variables de servicio-operaciones (README de specs, D-16). En Docker Compose ya las define
# docker-compose.yml; este archivo solo documenta qué espera el servicio.

# DynamoDB y S3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_PREFIJO_TABLAS=
AWS_ENDPOINT=http://localstack:4566
AWS_ENDPOINT_PUBLICO=http://localhost:4566
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=evidencias

# RabbitMQ (desde spec-saga.md)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sw2
RABBITMQ_PASSWORD=sw2pass
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# Keycloak y consulta de campaña a servicio-gestion por el Gateway
KEYCLOAK_ISSUER=http://localhost:8180/realms/agro
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/agro/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=servicio-operaciones
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/agro/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=servicio-operaciones
KEYCLOAK_CLIENT_SECRET=
API_GATEWAY_URL=http://api-gateway:8080
