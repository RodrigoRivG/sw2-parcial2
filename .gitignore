# Secretos y configuración local (RNF-03)
.env
.env.*
!.env.example
!.env.despliegue.example
# Sin secretos: solo hace que Laravel no busque .env en los tests de operaciones
!servicios/servicio-operaciones/.env.testing
# Cuenta de servicio de Firebase y otros secretos de n8n (spec-n8n.md, T01)
docker/n8n/secretos/*
!docker/n8n/secretos/.gitkeep

# Borradores de la constitución y las specs de los microfrontends: el código y la copia
# definitiva viven en su propio repositorio (Windows)
frontends/

# Java / Maven
target/
*.class

# Node.js / NestJS / Apollo
node_modules/
dist/
coverage/
*.tsbuildinfo
.eslintcache

# PHP / Laravel
vendor/
bootstrap/cache/*.php
.phpunit.cache/
.phpunit.result.cache

# Python / FastAPI
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Modelos de IA: se versionan en Cloud Storage, no en el repositorio
*.joblib
*.h5
*.keras
*.tflite

# Logs
*.log

# Editores y sistema operativo
.idea/
.vscode/
.claude/settings.local.json
.DS_Store
Thumbs.db
Zone.Identifier
*:Zone.Identifier
